APP_NAME="絆記録会 エントリー"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ローカルではSQLite。Xserverでは mysql にして下の5項目を設定する
DB_CONNECTION=sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=xxxx_kizuna
# DB_USERNAME=xxxx_kizuna
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# レンタルサーバーでは常駐プロセスを動かせないので、メールはその場で送る
QUEUE_CONNECTION=sync
CACHE_STORE=database

# ローカルではメールをログ（storage/logs/laravel.log）に書き出す。
# Xserverでは MAIL_MAILER=smtp にして、サーバーパネルで作ったメールアカウントを設定する
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=sv0000.xserver.jp
MAIL_PORT=465
MAIL_USERNAME=entry@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="entry@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe（カード払い。ダッシュボード → 開発者 → APIキー / Webhook）。最初はテストモードのキー（sk_test_…）を使う
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# KOMOJU（コンビニ払い）。管理画面の「設定 → API鍵」の秘密鍵と、Webhookに設定した秘密トークン
KOMOJU_SECRET=
KOMOJU_WEBHOOK_SECRET=
# コンビニ払いの手数料（円）。申込者の負担として合計に足す（0なら手数料なし）
KOMOJU_FEE=0

# 領収書の発行者（初期値は株式会社アスリートキャリアセンター・登録番号T6012301013979。変えるときだけ入れる）
# KIZUNA_RECEIPT_ISSUER=
# KIZUNA_INVOICE_NUMBER=
# KIZUNA_RECEIPT_ADDRESS=
# KIZUNA_RECEIPT_PHONE=

# 入金完了メールのコピー（BCC）を受け取る運営のアドレス（任意）
KIZUNA_ADMIN_EMAIL=
# 運営者にするアカウント（カンマ区切り）。Vercel のテスト環境ではデプロイのたびに反映
KIZUNA_ADMIN_ACCOUNTS=
